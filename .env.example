# Required for normal local/Docker runs: none. The deterministic rules engine runs offline.
PORT=8000
LOG_LEVEL=INFO
HIGH_VALUE_BDT=50000

# Optional non-authoritative language/ambiguity hints only. Keep disabled for judge reliability.
ENABLE_LLM=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
LLM_TIMEOUT=8
