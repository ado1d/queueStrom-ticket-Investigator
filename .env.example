# Copy to .env and fill values. Never commit .env.

# --- Server ---
PORT=8000

# --- LLM provider ---
# Set ENABLE_LLM=true and provide at least ONE of the keys below.
# The code auto-picks the provider:
#   * If LLM_PROVIDER is set explicitly (groq | gemini), that one is used.
#   * Else if GROQ_API_KEY is set, Groq is used (recommended — 30 RPM free tier).
#   * Else if GEMINI_API_KEY is set, Gemini is used (15 RPM free tier).
#   * Else LLM is disabled (rules-only — still passes all 10 sample cases).
ENABLE_LLM=true
LLM_PROVIDER=groq

# Groq (recommended) — get a free key at https://console.groq.com/keys
# Free tier: 30 RPM, 14,000 RPD. Model: llama-3.3-70b-versatile.
GROQ_API_KEY=

# Gemini (fallback) — get a free key at https://aistudio.google.com/app/apikey
# Free tier: 15 RPM, 1,500 RPD. Model: gemini-2.5-flash.
# NOTE: Keys must start with "AIzaSy..." — tokens starting with "AQ." will not work.
GEMINI_API_KEY=

# --- LLM behaviour ---
LLM_TIMEOUT=8
LOG_LEVEL=INFO
